{
  "name": "network-site-template",
  "version": "1.0.0",
  "private": true,
  "description": "First-party Megapot Network cloneable site template — cribble-first, Cloudflare Pages, private /go.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/write-pages-routes.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "privacy": "tsx scripts/privacy-scan.ts",
    "utms": "tsx scripts/check-utms.ts",
    "go": "tsx scripts/check-go-redirect.ts",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm typecheck && pnpm privacy && pnpm utms && pnpm go",
    "preview": "wrangler pages dev out"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.2",
    "vitest": "5.0.1",
    "wrangler": "^4.132.0"
  }
}
